{
  "name": "lychen/api",
  "description": "Shared API Platform building blocks of the Lychen APIs: resources kept apart from the Doctrine model, relations exposed and written by uuid",
  "type": "library",
  "autoload": {
    "psr-4": {
      "Lychen\\Api\\": "src/"
    }
  },
  "authors": [
    {
      "name": "Lychen",
      "email": "bonjour@lychen.org"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": "^8.4",
    "api-platform/core": "^5.0",
    "doctrine/dbal": "^4.0",
    "doctrine/orm": "^3.0",
    "doctrine/persistence": "^3.3 || ^4.0",
    "lychen/model": "*",
    "symfony/config": "^7.4 || ^8.0",
    "symfony/dependency-injection": "^7.4 || ^8.0",
    "symfony/http-kernel": "^7.4 || ^8.0",
    "symfony/object-mapper": "^8.1.9",
    "symfony/uid": "^7.4 || ^8.0",
    "symfony/validator": "^7.4 || ^8.0"
  },
  "archive": {
    "exclude": [
      "/moon.yml"
    ]
  }
}
