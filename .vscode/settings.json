{
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
    //"source.organizeImports": "explicit"
  },
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "vue", "yaml"],
  "eslint.options": {
    "overrideConfigFile": "eslint.config.js"
  },
  // PHP: php-cs-fixer with the monorepo's config, formatting on save (editor.formatOnSave above).
  // The script runs it from its official Docker image, as the moon format tasks do: Docker must be
  // running, no PHP is needed on the host.
  "[php]": {
    "editor.defaultFormatter": "junstyle.php-cs-fixer"
  },
  "php-cs-fixer.executablePath": "${workspaceFolder}/.moon/scripts/php-cs-fixer.sh",
  "php-cs-fixer.config": ".php-cs-fixer.php",
  "editor.quickSuggestions": {
    //"strings": "on"
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "typescript.inlayHints.parameterNames.enabled": "none",
  "typescript.inlayHints.variableTypes.enabled": false,
  "typescript.suggest.paths": true,
  "files.autoSave": "onFocusChange",
  "prettier.configPath": "prettier.config.js",
  "prettier.vueIndentScriptAndStyle": false,
  "prettier.singleAttributePerLine": true,
  "path-intellisense.autoSlashAfterDirectory": true,
  "vue.inlayHints.missingProps": true,
  "vue.codeActions.enabled": true,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.moon/cache/**": true,
    "**/dist/**": true,
    "**/vendor/**": true,
    "**/.yarn/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.turbo": true,
    "**/.moon/cache": true,
    "**/dist": true,
    "**/vendor/**": true,
    "**/.yarn/**": true,
    "yarn.lock": true
  },
  "typescript.tsserver.maxTsServerMemory": 8192,
  "css.lint.unknownAtRules": "ignore",
  "typescript.tsserver.nodePath": "node",
  "vue.autoInsert.dotValue": false,
  "vue.inlayHints.optionsWrapper": false,
  "vue.splitEditors.icon": true,
  "editor.stickyScroll.enabled": true,
  //Auto rename tags
  "editor.linkedEditing": true,
  "javascript.preferences.renameMatchingJsxTags": true,
  "typescript.preferences.renameMatchingJsxTags": true,
  "svg.preview.background": "dark-transparent",
  "colorize.decoration_type": "background",
  "yaml.schemas": {
    "./.moon/cache/schemas/project.json": ["**/moon.yml"],
    "./.moon/cache/schemas/tasks.json": [".moon/tasks.yml", ".moon/tasks/**/*.yml"],
    "./.moon/cache/schemas/template.json": ["**/template.yml"],
    "./.moon/cache/schemas/toolchain.json": [".moon/toolchain.yml"],
    "./.moon/cache/schemas/workspace.json": [".moon/workspace.yml"]
  }
}
