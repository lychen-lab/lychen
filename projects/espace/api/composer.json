{
    "type": "project",
    "license": "proprietary",
    "name": "lychen/espace-api",
    "description": "",
    "require": {
        "php": ">=8.4",
        "ext-amqp": "*",
        "ext-ctype": "*",
        "ext-dom": "*",
        "ext-exif": "*",
        "ext-libxml": "*",
        "ext-openssl": "*",
        "ext-xml": "*",
        "api-platform/core": "4.2.*",
        "doctrine/doctrine-bundle": "3.2.*",
        "doctrine/doctrine-migrations-bundle": "4.0.*",
        "doctrine/orm": "3.6.*",
        "gedmo/doctrine-extensions": "3.22.*",
        "lychen/core": "*",
        "lychen/model": "*",
        "lychen/tiptap": "*",
        "lychen/zitadel": "*",
        "martin-georgiev/postgresql-for-doctrine": "4.0.*",
        "nelmio/cors-bundle": "2.6.*",
        "phpdocumentor/reflection-docblock": "5.6.*",
        "predis/predis": "3.3.*",
        "runtime/frankenphp-symfony": "1.0.*",
        "scienta/doctrine-json-functions": "6.3.*",
        "sentry/sentry-symfony": "5.8.*",
        "snc/redis-bundle": "4.10.*",
        "symfony/amqp-messenger": "7.4.*",
        "symfony/asset": "7.4.*",
        "symfony/clock": "7.4.*",
        "symfony/config": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/doctrine-messenger": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/expression-language": "7.4.*",
        "symfony/flex": "2.10.*",
        "symfony/form": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/intl": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/messenger": "7.4.*",
        "symfony/monolog-bundle": "4.0.*",
        "symfony/process": "7.4.*",
        "symfony/property-access": "7.4.*",
        "symfony/property-info": "7.4.*",
        "symfony/rate-limiter": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/uid": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/workflow": "7.4.*",
        "symfony/yaml": "7.4.*",
        "symfony/object-mapper": "7.4.*"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "8.4.*",
        "doctrine/doctrine-fixtures-bundle": "4.3.*",
        "justinrainbow/json-schema": "6.4.*",
        "mtdowling/jmespath.php": "2.8.*",
        "phpstan/phpstan-doctrine": "2.0.*",
        "phpunit/phpunit": "12.5.*",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/debug-bundle": "7.4.*",
        "symfony/maker-bundle": "1.65.*",
        "symfony/phpunit-bridge": "7.4.*",
        "symfony/stopwatch": "7.4.*",
        "symfony/web-profiler-bundle": "7.4.*",
        "zenstruck/browser": "1.9.*",
        "zenstruck/foundry": "2.8.*",
        "zenstruck/messenger-test": "1.13.*"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "lychen/model": "0.0.0",
                    "lychen/zitadel": "0.0.0",
                    "lychen/tiptap": "0.0.0",
                    "lychen/core": "0.0.0"
                }
            }
        }
    ],
    "config": {
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "doctrine:cache:clear-metadata": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "7.4.*",
            "docker": true
        }
    }
