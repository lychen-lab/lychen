parameters:
	ignoreErrors:
		-
			message: '#^Property App\\Entity\\ConsumptionMethod\:\:\$code type mapping mismatch\: property can contain string\|null but database expects string\.$#'
			identifier: doctrine.columnType
			count: 1
			path: src/Entity/ConsumptionMethod.php

		-
			message: '#^Property App\\Entity\\Cultivation\:\:\$exposure type mapping mismatch\: property can contain App\\Entity\\Exposure\|null but database expects App\\Entity\\Exposure\.$#'
			identifier: doctrine.associationType
			count: 1
			path: src/Entity/Cultivation.php

		-
			message: '#^Property App\\Entity\\Cultivation\:\:\$maturity type mapping mismatch\: property can contain App\\Entity\\Maturity\|null but database expects App\\Entity\\Maturity\.$#'
			identifier: doctrine.associationType
			count: 1
			path: src/Entity/Cultivation.php

		-
			message: '#^Property App\\Entity\\Exposure\:\:\$code type mapping mismatch\: property can contain string\|null but database expects string\.$#'
			identifier: doctrine.columnType
			count: 1
