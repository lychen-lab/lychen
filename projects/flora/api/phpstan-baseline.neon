			identifier: doctrine.columnType
			count: 1
			path: src/Entity/Part.php

		-
			message: '#^Property App\\Entity\\Plant\:\:\$cultivation type mapping mismatch\: property can contain App\\Entity\\Cultivation\|null but database expects App\\Entity\\Cultivation\.$#'
			identifier: doctrine.associationType
			count: 1
			path: src/Entity/Plant.php

		-
			message: '#^Property App\\Entity\\Plant\:\:\$medicinal type mapping mismatch\: property can contain bool\|null but database expects bool\.$#'
			identifier: doctrine.columnType
			count: 1
			path: src/Entity/Plant.php

