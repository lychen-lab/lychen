### DO NOT SET VALUES -> Use .env.local (gitignored) locally, or set them in Dokploy per environment ###

# Pin a real stable tag for staging/prod (e.g. v2.71.0). Local may stay on latest.
ZITADEL_VERSION=

# External exposure — Dokploy's domain feature handles ingress + TLS.
# staging/prod: EXTERNALSECURE=true, EXTERNALPORT=443, EXTERNALDOMAIN=staging.account.lychen.org
ZITADEL_EXTERNALDOMAIN=
ZITADEL_EXTERNALPORT=
ZITADEL_EXTERNALSECURE=
ZITADEL_MASTERKEY=
ZITADEL_SMTP_SENDER_MATCHES_DOMAIN=

# Bundled Postgres
ZITADEL_DATABASE_POSTGRES_DB=
ZITADEL_DATABASE_POSTGRES_USER_USERNAME=
ZITADEL_DATABASE_POSTGRES_USER_PASSWORD=
ZITADEL_DATABASE_POSTGRES_USER_SSL_MODE=
ZITADEL_DATABASE_POSTGRES_ADMIN_USERNAME=
ZITADEL_DATABASE_POSTGRES_ADMIN_PASSWORD=
ZITADEL_DATABASE_POSTGRES_ADMIN_SSL_MODE=

# First-instance human admin
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_USERNAME=
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD=
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORDCHANGEREQUIRED=

# Provisioner service account (PAT auto-written to a shared volume on first init)
ZITADEL_PROVISIONER_USERNAME=
ZITADEL_PROVISIONER_PAT_EXPIRATION=

# Provisioning targets — base URLs of the SPAs (used to build OIDC redirect URIs)
TERA_APP_BASE_URL=
ESPACE_APP_BASE_URL=
