# Development environment override
services:
  database:
    ports:
      - '21432:5432/tcp' #TODO Change it
  api:
    build:
      context: .
      target: frankenphp_dev
    environment:
      SERVER_NAME: api.{{ name }}.lychen.local
      #MERCURE_EXTRA_DIRECTIVES: demo
      # See https://xdebug.org/docs/all_settings#mode
      XDEBUG_MODE: '${XDEBUG_MODE:-off}'
    extra_hosts:
      # Ensure that host.docker.internal is correctly defined on Linux
      - host.docker.internal:host-gateway
    tty: true
    volumes:
      - ./:/app
      #- ./var:/app/var
      - ./frankenphp/Caddyfile:/etc/caddy/Caddyfile:ro
      - ./frankenphp/conf.d/20-app.dev.ini:/usr/local/etc/php/app.conf.d/20-app.dev.ini:ro
    ports:
      - protocol: tcp
        published: ${HTTP_PORT:-8080} #TODO Change it
        target: 80
      - protocol: tcp
        published: ${HTTPS_PORT:-30443} #TODO Change it
        target: 443
      - protocol: udp
        published: ${HTTP3_PORT:-40443} #TODO Change it
        target: 443
    networks:
      # `default` is kept explicitly: naming any network opts a service out of
      # the implicit one, which would cut the API off from its own database and
      # redis. Only `api` joins the shared network, where it reaches the central
      # RabbitMQ and mailpit.
      - default
      - lychen-network

networks:
  lychen-network:
    external: true
