# The front's only access to {{ api }}-api: one Tanstack Query composable per endpoint
# (endpoint/<resource>/), whatever the endpoint: its request and its own mapping to the
# front's models, on top of libs/vue/api-query. The models are the front's own
# (libs/typescript/{{ api }}-models). Scaffolded by `moon generate api-front`.
dependsOn:
  - typescript-api-client
  - typescript-api-mapping
  - typescript-{{ api }}-api-sdk
  - typescript-{{ api }}-models
  - typescript-zitadel
  - vue-api-query
id: vue-{{ api }}-api
language: typescript
layer: library
# Inherits lint, format, typecheck and test from .moon/tasks/frontend.yml.
stack: frontend
