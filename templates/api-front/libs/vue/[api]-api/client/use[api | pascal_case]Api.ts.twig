{%- set Api = api | pascal_case -%}
import { {{ Api }}Api } from '@lychen/typescript-{{ api }}-api-sdk/generated/{{ api }}-api';
import { createClient } from '@lychen/typescript-{{ api }}-api-sdk/generated/{{ api }}-api/client';
import { createApiClient } from '@lychen/typescript-api-client/createApiClient';
import { getAccessToken } from '@lychen/typescript-zitadel/getAccessToken';

// Set up like every API's client (libs/typescript/api-client), with the signed-in
// user's token: pass `interceptors` to change {{ api }}'s own.
const api = new {{ Api }}Api({
  client: createApiClient(createClient, {
    baseUrl: import.meta.env.{% if env %}{{ env }}{% else %}VITE_{{ api | upper_snake_case }}_API_URL{% endif %},
    bearerToken: getAccessToken,
  }),
});

/**
 * The {{ api }}-api SDK, for this lib's endpoint composables only: the front calls those,
 * which speak its models, never the SDK and the API's representations directly.
 */
export function use{{ Api }}Api() {
  return { api };
}
