{%- set Api = api | pascal_case -%}
{%- set Name = name | pascal_case -%}
{%- set Op = operation | pascal_case -%}
{%- set name_camel = name | camel_case -%}
{%- set resource_camel = resource | camel_case -%}
{%- set keys = resource_camel ~ "Keys" -%}
{%- set sdk = "'@lychen/typescript-" ~ api ~ "-api-sdk/generated/" ~ api ~ "-api'" -%}
{%- if file -%}{%- set module = file -%}{%- else -%}{%- set module = model -%}{%- endif -%}
{%- if operation is ending_with("Get") or operation is ending_with("GetCollection") -%}
{%- set list = operation is ending_with("GetCollection") -%}
import type { {{ Op }}Data, {{ Op }}Response } from {{ sdk }};
{%- if list %}
import type { Collection } from '@lychen/typescript-api-mapping/Collection';
import { toCollection } from '@lychen/typescript-api-mapping/mapping';
{%- endif %}
import type { {{ model }} } from '@lychen/typescript-{{ api }}-models/{{ module }}';
import type { ApiQueryOptions } from '@lychen/vue-api-query/options';
import { useApiQuery } from '@lychen/vue-api-query/useApiQuery';
import type { MaybeRefOrGetter } from 'vue';
import { use{{ Api }}Api } from '../../client/use{{ Api }}Api';
import { {{ keys }} } from './queryKeys';

/** What the front gives this endpoint, under its own names. TODO: e.g. an id, filters. */
export type {{ Name }}Params = Record<string, never>;

/** The cache key of `use{{ Name }}`. */
export function {{ name_camel }}QueryKey(params: {{ Name }}Params | undefined) {
  return {{ keys }}.of('{{ name }}', params);
}

/**
 * `{{ operation }}`. TODO: what it gives, in the front's words. The query waits while the
 * params are undefined, and fetches again whenever they change.
 */
export function use{{ Name }}(
  params: MaybeRefOrGetter<{{ Name }}Params | undefined>,
  options: ApiQueryOptions<{% if list %}Collection<{{ model }}>{% else %}{{ model }}{% endif %}> = {},
) {
  const { api } = use{{ Api }}Api();

  return useApiQuery(
    params,
    {
      queryKey: {{ name_camel }}QueryKey,
      async fetch(current) {
        const { data } = await api.{{ operation }}({ ...mapToRequest(current), throwOnError: true });
        return {% if list %}toCollection(data, mapToModel){% else %}mapToModel(data){% endif %};
      },
    },
    options,
  );
}

/** The request these params make, under the API's names. */
export function mapToRequest(params: {{ Name }}Params): Omit<{{ Op }}Data, 'url'> {
  return {
    // TODO: path and query, from the params.
  };
}

/**
 * {% if list %}A member of the page{% else %}The response{% endif %} as the front's model: list its fields one by one, under the front's
 * names, never with a spread.
 */
export function mapToModel(data: {{ Op }}Response{% if list %}['member'][number]{% endif %}): {{ model }} {
  return {
    // TODO: every field of the model.
  };
}
{%- elif operation is ending_with("Delete") %}
import type { {{ Op }}Data } from {{ sdk }};
import type { ApiMutationOptions } from '@lychen/vue-api-query/options';
import { useApiMutation } from '@lychen/vue-api-query/useApiMutation';
import { use{{ Api }}Api } from '../../client/use{{ Api }}Api';
import { {{ keys }} } from './queryKeys';

/** What the front gives this endpoint, under its own names. TODO: usually the id. */
export type {{ Name }}Variables = Record<string, never>;

/** `{{ operation }}`. TODO: what it deletes, in the front's words. */
export function use{{ Name }}(options: ApiMutationOptions<void, {{ Name }}Variables> = {}) {
  const { api } = use{{ Api }}Api();

  return useApiMutation(
    {
      async send(variables: {{ Name }}Variables) {
        await api.{{ operation }}({ ...mapToRequest(variables), throwOnError: true });
      },
      // TODO: drop the deleted item's queries, which a refetch would only fail:
      // update: (queryClient, _, variables) =>
      //   queryClient.removeQueries({ queryKey: getXQueryKey(variables.id) }),
      invalidates: () => [{{ keys }}.all],
    },
    options,
  );
}

/** The request, from the front's input, under the API's names. */
export function mapToRequest(variables: {{ Name }}Variables): Omit<{{ Op }}Data, 'url'> {
  return {
    // TODO: the path, from the variables.
  };
}
{%- else %}
import type { {{ Op }}Data, {{ Op }}Response } from {{ sdk }};
import type { {{ model }} } from '@lychen/typescript-{{ api }}-models/{{ module }}';
import type { ApiMutationOptions } from '@lychen/vue-api-query/options';
import { useApiMutation } from '@lychen/vue-api-query/useApiMutation';
import { use{{ Api }}Api } from '../../client/use{{ Api }}Api';
import { {{ keys }} } from './queryKeys';

/** What the front gives this endpoint, under its own names. TODO: its fields. */
export type {{ Name }}Variables = Record<string, never>;

/** `{{ operation }}`. TODO: what it does, in the front's words. */
export function use{{ Name }}(options: ApiMutationOptions<{{ model }}, {{ Name }}Variables> = {}) {
  const { api } = use{{ Api }}Api();

  return useApiMutation(
    {
      async send(variables: {{ Name }}Variables) {
        const { data } = await api.{{ operation }}({ ...mapToRequest(variables), throwOnError: true });
        return mapToModel(data);
      },
      // TODO: the queries of every other resource the change touches too, as a transition may.
      invalidates: () => [{{ keys }}.all],
    },
    options,
  );
}

/** The request, from the front's input, under the API's names. */
export function mapToRequest(variables: {{ Name }}Variables): Omit<{{ Op }}Data, 'url'> {
  return {
    // TODO: path, query and body, from the variables (withoutUndefined for a merge patch).
  };
}

/**
 * The response as the front's model: list its fields one by one, under the front's names,
 * never with a spread.
 */
export function mapToModel(data: {{ Op }}Response): {{ model }} {
  return {
    // TODO: every field of the model.
  };
}
{%- endif %}
