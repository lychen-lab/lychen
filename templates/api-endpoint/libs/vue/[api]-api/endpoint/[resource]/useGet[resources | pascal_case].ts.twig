{%- set Api = api | pascal_case -%}
{%- set Resource = resource | pascal_case -%}
{%- set Resources = resources | pascal_case -%}
{%- set Id = id | pascal_case -%}
{%- set resource_camel = resource | camel_case -%}
{%- set keys = resource_camel ~ "Keys" -%}
{%- set label = resource | replace(from="-", to=" ") -%}
{%- set labels = resources | replace(from="-", to=" ") -%}
{%- set resources_snake = resources | snake_case -%}
{%- set path = "/api/" ~ resources_snake -%}
{%- set item_path = path ~ "/{" ~ id ~ "}" -%}
import type { Collection } from '@lychen/typescript-api-mapping/Collection';
import { toCollection, withoutUndefined } from '@lychen/typescript-api-mapping/mapping';
import type {
  {{ Resource }}Filters,
  {{ Resource }}Summary,
} from '@lychen/typescript-{{ api }}-models/{{ Resource }}';
import type { ApiQueryOptions } from '@lychen/vue-api-query/options';
import { useCollectionQuery } from '@lychen/vue-api-query/useCollectionQuery';
import type { MaybeRefOrGetter } from 'vue';
import { use{{ Api }}Api } from '../../client/use{{ Api }}Api';
import { mapToSummaryModel } from './mapper';
import { {{ keys }} } from './queryKeys';

/**
 * A page of the {{ labels }}, `GET {{ path }}`. The query fetches again whenever
 * the filters change.
 */
export function useGet{{ Resources }}(
  filters: MaybeRefOrGetter<{{ Resource }}Filters> = {},
  options: ApiQueryOptions<Collection<{{ Resource }}Summary>> = {},
) {
  const { api } = use{{ Api }}Api();

  return useCollectionQuery(
    filters,
    {
      queryKey: {{ keys }}.list,
      async fetch({ page, itemsPerPage }) {
        const { data } = await api.api{{ Resources }}GetCollection({
          // The filters under the API's names, which the front's are free to differ from.
          query: withoutUndefined({ page, itemsPerPage }),
          throwOnError: true,
        });
        return toCollection(data, mapToSummaryModel);
      },
    },
    options,
  );
}
