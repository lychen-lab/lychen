{%- set Api = api | pascal_case -%}
{%- set Resource = resource | pascal_case -%}
{%- set Resources = resources | pascal_case -%}
{%- set Id = id | pascal_case -%}
{%- set resource_camel = resource | camel_case -%}
{%- set keys = resource_camel ~ "Keys" -%}
{%- set label = resource | replace(from="-", to=" ") -%}
{%- set labels = resources | replace(from="-", to=" ") -%}
{%- set resources_snake = resources | snake_case -%}
{%- set path = "/api/" ~ resources_snake -%}
{%- set item_path = path ~ "/{" ~ id ~ "}" -%}
import type {
  {{ Resource }},
  {{ Resource }}CreateInput,
} from '@lychen/typescript-{{ api }}-models/{{ Resource }}';
import type { ApiMutationOptions } from '@lychen/vue-api-query/options';
import { useSaveMutation } from '@lychen/vue-api-query/useSaveMutation';
import { use{{ Api }}Api } from '../../client/use{{ Api }}Api';
import { mapToCreateBody, mapToModel } from './mapper';
import { {{ keys }} } from './queryKeys';

/** `POST {{ path }}`, from the front's input: resolves with the created {{ label }}. */
export function useCreate{{ Resource }}(
  options: ApiMutationOptions<{{ Resource }}, {{ Resource }}CreateInput> = {},
) {
  const { api } = use{{ Api }}Api();

  return useSaveMutation(
    {
      queryKeys: {{ keys }},
      async save(input: {{ Resource }}CreateInput) {
        const { data } = await api.api{{ Resources }}Post({ body: mapToCreateBody(input), throwOnError: true });
        return mapToModel(data);
      },
      idOf: (saved) => saved.{{ id }},
    },
    options,
  );
}
